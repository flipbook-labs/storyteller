{
  "name": "storyteller-dev-tools",
  "private": true,
  "scripts": {
    "format:markdown": "prettier --write \"*.md\" \".agents/**/*.md\" \".changes/**/*.md\" \"docs/**/*.md\" \"src/**/*.md\"",
